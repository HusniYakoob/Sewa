# Sewa environment variables. Copy to .env.local and fill in.
# .env.local is gitignored. Never commit real secrets.

# --- Supabase ---
# Project URL and anon key are safe for the browser (public).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is SERVER ONLY. Bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- PayHere (Phase 0 verification pending) ---
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_WEBHOOK_SECRET=
# Sandbox: https://sandbox.payhere.lk/pay  |  Live: https://www.payhere.lk/pay
PAYHERE_PAYMENT_URL=https://sandbox.payhere.lk/pay

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
